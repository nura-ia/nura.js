{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": ".coverage-dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@nura-js/core": ["test/types/core.d.ts"]
    }
  },
  "include": ["src"]
}
