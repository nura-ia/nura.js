{
  "name": "@nura-js/core",
  "version": "0.2.0",
  "description": "Typed action, policy, context, and agent primitives for Nura.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nura-ia/nura.js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nura-ia/nura.js/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/nura-ia/nura.js/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs",
      "types": "./dist/agent.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs",
      "types": "./dist/runtime.d.ts"
    },
    "./permissions": {
      "import": "./dist/permissions.js",
      "require": "./dist/permissions.cjs",
      "types": "./dist/permissions.d.ts"
    },
    "./wake": {
      "import": "./dist/wake.js",
      "require": "./dist/wake.cjs",
      "types": "./dist/wake.d.ts"
    },
    "./context": {
      "import": "./dist/context.js",
      "require": "./dist/context.cjs",
      "types": "./dist/context.d.ts"
    },
    "./locale": {
      "import": "./dist/locale.js",
      "require": "./dist/locale.cjs",
      "types": "./dist/locale.d.ts"
    },
    "./numerals": {
      "import": "./dist/numerals.js",
      "require": "./dist/numerals.cjs",
      "types": "./dist/numerals.d.ts"
    },
    "./synonyms": {
      "import": "./dist/synonyms.js",
      "require": "./dist/synonyms.cjs",
      "types": "./dist/synonyms.d.ts"
    },
    "./entities": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.spec.mjs",
    "test:coverage": "node -e \"require('node:fs').rmSync('.coverage-dist',{recursive:true,force:true})\" && tsc -p tsconfig.coverage.json && node -e \"require('node:fs').writeFileSync('.coverage-dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\" && node --test --experimental-test-coverage --test-coverage-include='.coverage-dist/agent.js' --test-coverage-include='.coverage-dist/runtime.js' --test-coverage-include='.coverage-dist/permissions.js' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 test/coverage/critical.test.mjs"
  },
  "keywords": [
    "nura",
    "ai",
    "agents",
    "semantic",
    "commands",
    "llm"
  ],
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@nura-js/plugin-fuzzy": "workspace:*",
    "tslib": "^2.6.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Nura Dev Team"
}
