{
  "name": "nura",
  "version": "0.1.0",
  "private": true,
  "description": "Typed agent and UI runtime for safe AI-controllable web applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nura-ia/nura.js.git"
  },
  "homepage": "https://github.com/nura-ia/nura.js",
  "bugs": {
    "url": "https://github.com/nura-ia/nura.js/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"!./apps/**\" --filter \"!./packages/examples/**\" run build",
    "typecheck": "pnpm -r --filter \"@nura-js/*\" --filter \"!@nura-js/examples\" run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm --filter @nura-js/core run test:coverage && pnpm --filter @nura-js/dom run test:coverage && pnpm --filter @nura-js/transport-http run test:coverage",
    "build:all": "pnpm -r run build",
    "typecheck:all": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "docs:lint": "markdownlint '**/*.md' -i node_modules",
    "docs:links": "markdown-link-check -p -v README.md docs/**/*.md",
    "docs:spell": "cspell --no-progress \"**/*.md\"",
    "docs:check": "pnpm docs:lint && pnpm docs:links && pnpm docs:spell",
    "pack:clean": "rimraf .packs && mkdir .packs",
    "pack:each": "pnpm -r --filter \"@nura-js/*\" --filter \"!@nura-js/examples\" --filter \"!@nura-js/devtools-lexicon\" --workspace-concurrency=1 exec -- pnpm pack --pack-destination ../../.packs",
    "pack:ls": "node -e \"require('fs').readdirSync('.packs').forEach(f=>console.log(f))\"",
    "smoke": "node scripts/smoke.mjs",
    "verify:release": "pnpm typecheck && pnpm build && pnpm test && pnpm test:coverage && pnpm pack:clean && pnpm pack:each && pnpm smoke"
  },
  "dependencies": {
    "@nura-js/core": "workspace:*",
    "@nura-js/dom": "workspace:*",
    "@nura-js/react": "workspace:*",
    "@nura-js/client": "workspace:*",
    "@nura-js/intents": "workspace:*",
    "@nura-js/transport-http": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "react": "^19",
    "react-dom": "^19",
    "svelte": "latest",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cspell": "^8.17.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.10.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.9.2",
    "fuse.js": "^7.5.0",
    "gh-pages": "^6.1.1",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5",
    "prettier": "^3.9.5",
    "rimraf": "^5.0.7",
    "supertest": "^7.2.2",
    "tailwindcss": "4.3.2",
    "tsup": "^8.5.1",
    "turbo": "^2.10.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitepress": "^1.4.3",
    "vitepress-plugin-search": "1.0.4-alpha.22",
    "vitest": "^2.1.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.15.0"
  }
}
